# App database used by Prisma. Create this database before running migrations.
DATABASE_URL="postgresql://dbos_user:dbos_dev_password@localhost:5432/dbos_workflows?schema=public"

# DBOS system database. For local development this can be the same database.
DBOS_SYSTEM_DATABASE_URL="postgresql://dbos_user:dbos_dev_password@localhost:5432/dbos_workflows"

# Must match the DBOS application name in worker/index.ts
DBOS_APP_NAME="dbos-workflow"
